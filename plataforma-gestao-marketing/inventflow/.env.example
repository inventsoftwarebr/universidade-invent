# ------------------------------------------------------------------
# Banco
# ------------------------------------------------------------------
# Em serverless (Vercel), aponte para o pooler em transaction mode (6543).
DATABASE_URL=postgresql://inventflow:inventflow@127.0.0.1:5432/inventflow
# Conexão direta (5432). Usada só por drizzle-kit, fora de serverless.
DIRECT_URL=postgresql://inventflow:inventflow@127.0.0.1:5432/inventflow

# ------------------------------------------------------------------
# Sessão
# ------------------------------------------------------------------
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
SESSION_SECRET=troque-esta-chave-por-uma-aleatoria-de-48-bytes

APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# Microsoft Entra ID (SSO)
# ------------------------------------------------------------------
# Sem estas três variáveis a aplicação sobe em MODO PILOTO: a tela de entrada
# lista o time e não pede senha. Aceitável para o alpha/beta interno, nunca
# para produção com dado real.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
